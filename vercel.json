{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://medpobeda-api.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://medpobeda-api.onrender.com/media/:path*"
    },
    {
      "source": "/health",
      "destination": "https://medpobeda-api.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
