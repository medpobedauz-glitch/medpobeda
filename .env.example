# MedPobeda environment variables (copy to .env and fill in real values)
# Never commit .env. These are placeholder variable names only.

# HTTP
PORT=4000

# Session secrets — generate strong random values in production:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# In production set to true so cookies are only sent over HTTPS.
COOKIE_SECURE=false
# Set to 1 behind the hosting provider's HTTPS reverse proxy.
TRUST_PROXY_HOPS=0

# Short-lived admin session TTL (hours).
SESSION_TTL_HOURS=8

# SQLite database file (relative to project root).
DATABASE_PATH=storage/medpobeda.sqlite

# Where uploaded images live on disk (relative to project root).
STORAGE_DIR=storage/uploads

# Max upload size per file in megabytes.
MAX_UPLOAD_MB=8

# Public site origin (used for CORS / cookie scope; keep default in dev).
PUBLIC_ORIGIN=http://localhost:3000
# Private PDF staging and local taxonomy classification
PDF_IMPORT_DIR=storage/pdf-imports
# PDF_PYTHON=/absolute/path/to/.venv-pdf/bin/python
PDF_MAX_UPLOAD_MB=512
PDF_OLLAMA_URL=http://127.0.0.1:11434
PDF_OLLAMA_MODEL=gemma3:1b
PDF_CLASSIFICATION_THRESHOLD=0.85
PDF_ENABLE_OCR=false

# Optional central Question Bank AI. CRUD/import/export work without AI.
QBANK_AI_PROVIDER=ollama
QBANK_OLLAMA_URL=http://127.0.0.1:11434
QBANK_OLLAMA_MODEL=gemma3:1b
# Existing three-language editor keeps its original translation backend.
# Optional opt-in only: QUESTION_TRANSLATION_PROVIDER=ollama

# App backend login adapter (not a completed Q Bank integration).
# Keep disabled until the Java password check is fixed/verified. See APP-INTEGRATION.md.
MEDPOBEDA_APP_LOGIN_ENABLED=false
MEDPOBEDA_APP_API_ORIGIN=https://api.medpobeda.com
# No JWT signing secret or PostgreSQL password is required for API login.
